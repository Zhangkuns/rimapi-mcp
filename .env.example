# Default: game on this computer. Replace with your reachable API address.
# HTTPS example: https://rimapi.example.com/api/v1
# Tailscale example: http://game-host:18765/api/v1
RIMAPI_BASE_URL=http://localhost:8765/api/v1
# Must match the GAME's configured token. Empty is valid when its auth is off.
# Setting this client value does not enable authentication on the game server.
RIMAPI_API_TOKEN=
# Optional viewer, e.g. https://rimworld.example.com/; leave empty if unused.
# Browser Access login is separate from API Bearer authentication.
RIMAPI_VIEW_URL=
RIMAPI_TIMEOUT_SECONDS=30
