# Host or full /api/v1 base; no public port forwarding is required.
# Replace game-host with your game's reachable hostname or Tailscale address.
RIMAPI_BASE_URL=http://game-host:18765/api/v1
# Must match the GAME's configured token. Empty is valid when its auth is off.
# Setting this client value does not enable authentication on the game server.
RIMAPI_API_TOKEN=
# Optional browser game-view URL; leave empty if no viewer is configured.
RIMAPI_VIEW_URL=
RIMAPI_TIMEOUT_SECONDS=30
